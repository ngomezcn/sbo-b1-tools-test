<mvc:View controllerName="notification.ui.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout= "sap.ui.layout"
    xmlns:uxap="sap.uxap"
    xmlns:core="sap.ui.core" displayBlock="true">

    <Page>
        <customHeader>
            <f:ShellBar title="Partner's Webhook Service" secondTitle="Notification Details" homeIcon="./resources/SAPBusinessOne.jpg" showCopilot="true" showSearch="true" showNavButton="true" navButtonPressed=".onNavBack" showNotifications="true" notificationsNumber="{notifications>/notificationsCount}">
                <f:menu>
                    <Menu>
                    </Menu>
                </f:menu>
                <f:profile>
                    <Avatar initials="WH"/>
                </f:profile>
            </f:ShellBar>
        </customHeader>

        <content>
            <uxap:ObjectPageLayout id="objectPageLayout" showTitleInHeaderContent="true" showEditHeaderButton="false" showFooter="false">
                <uxap:headerTitle>
                    <uxap:ObjectPageDynamicHeaderTitle>
                        <uxap:heading>
                            <Title text="{notification>/type}"/>
                        </uxap:heading>
                        <uxap:expandedHeading>
                            <Title text="{notification>/type}"/>
                        </uxap:expandedHeading>
                        <uxap:snappedHeading>
                            <Title text="{notification>/type}"/>
                        </uxap:snappedHeading>
                        <uxap:actions>
                            <Button icon="sap-icon://action" text="Query ServiceLayer" press=".onQueryServiceLayer"/>
                        </uxap:actions>
                    </uxap:ObjectPageDynamicHeaderTitle>
                </uxap:headerTitle>

                <uxap:headerContent>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Notification No." labelFor="notificationNo"/>
                        <Text id="notificationNo" text="{notification>/notificationNo}"/>

                        <Label text="Notification ID" labelFor="notificationID" class="sapUiSmallMarginTop"/>
                        <Text id="notificationID" text="{notification>/id}"/>

                        <Label text="Creation Time" labelFor="time" class="sapUiSmallMarginTop"/>
                        <Text id="time" text="{
                            path: 'notification>/time',
                            formatter: '.formatDate'
                        }"/>
                    </VBox>
                </uxap:headerContent>

                <uxap:sections>
                    <uxap:ObjectPageSection title="Basic Information">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection>
                                <uxap:blocks>
                                    <VBox class="sapUiSmallMargin">
                                        <Label text="Spec Version" labelFor="specVersion"/>
                                        <Text id="specVersion" text="{notification>/specversion}" class="sapUiSmallMarginBottom"/>

                                        <Label text="Source" labelFor="source"/>
                                        <Text id="source" text="{notification>/source}" class="sapUiSmallMarginBottom"/>

                                        <Label text="Subject" labelFor="subject"/>
                                        <Text id="subject" text="{notification>/subject}" class="sapUiSmallMarginBottom"/>
                                    </VBox>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection title="Event Data">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection>
                                <uxap:blocks>
                                    <VBox class="sapUiSmallMargin">
                                        <Label text="Data Type" labelFor="dataType"/>
                                        <Text id="dataType" text="{notification>/datacontenttype}" class="sapUiSmallMarginBottom"/>

                                        <Label text="Data Content" labelFor="dataContent"/>
                                        <Text id="dataContent" text="{notification>/data}" class="sapUiSmallMarginBottom"/>
                                    </VBox>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection title="ServiceLayer Response" id="jsonSection" visible="false">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection>
                                <uxap:blocks>
                                    <VBox class="sapUiSmallMargin">
                                        <MessageStrip id="jsonViewerMessageStrip" text="Here are some more details retrieved from ServiceLayer by a technical user registered for this webhook service in the SAP Business One Extension SSO Manager." type="Information" showIcon="true" showCloseButton="false" class="sapUiSmallMarginBottom"/>
                                        <TextArea id="jsonViewer" width="100%" rows="15" editable="false" wrapping="true"/>
                                        <Button text="Close" press=".onCloseJsonViewer" class="sapUiSmallMarginBottom"/>
                                    </VBox>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>
                </uxap:sections>
            </uxap:ObjectPageLayout>
        </content>
    </Page>
</mvc:View>